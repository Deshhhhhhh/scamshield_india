# Copy to .env for local runs. Never commit real values.
SCAMSHIELD_DB_PATH=data/scamshield.db
SCAMSHIELD_RATE_LIMIT=30
SCAMSHIELD_LOG_LEVEL=INFO
SCAMSHIELD_ENV=local
# Optional: free-tier Gemini API key (aistudio.google.com). Without it, the offline fallback explainer runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Telegram bot (get token from @BotFather)
TELEGRAM_BOT_TOKEN=
SCAMSHIELD_API_URL=http://localhost:8000
